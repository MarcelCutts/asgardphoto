---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { getImageUrl } from '../../lib/images';

// Event dates are plain calendar days; format in UTC so the build machine's
// time zone cannot move one to the day before
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

export async function getStaticPaths() {
  const events = await getCollection('events');
  // Newest first, the order of the index
  const sorted = events.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return sorted.map((event, i) => ({
    params: { slug: event.id },
    props: { event, newer: sorted[i - 1], older: sorted[i + 1] },
  }));
}

const { event, newer, older } = Astro.props;
const { Content } = await render(event);

const photos = event.data.photos || [];
// OG image: use a larger size for social sharing
const ogImageUrl = getImageUrl(event.data.cover, {
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
---

<BaseLayout
  title={event.data.title}
  description={event.data.description ||
    `Photos from ${event.data.title} at ${event.data.location}`}
  ogImage={ogImageUrl}
  ogImageAlt={`Cover photo from ${event.data.title} at ${event.data.location}`}
>
  <article class="event-page">
    <header class="event-header gutter">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">All events</a>
      </nav>

      <h1>{event.data.title}</h1>

      <p class="event-meta">
        <span class="event-location">{event.data.location}</span>
        <time datetime={event.data.date.toISOString().slice(0, 10)}>
          {formatDate(event.data.date)}
        </time>
        {
          photos.length > 0 && (
            <span>
              {photos.length} photo{photos.length === 1 ? '' : 's'}
            </span>
          )
        }
      </p>

      {event.data.description && <p class="event-description">{event.data.description}</p>}

      <div class="event-content">
        <Content />
      </div>
    </header>

    {
      photos.length > 0 ? (
        <PhotoGrid photos={photos} eventTitle={event.data.title} />
      ) : (
        <p class="no-photos gutter">No photos from this event yet.</p>
      )
    }

    {
      (newer || older) && (
        <nav class="more-events gutter" aria-label="More events">
          {older && (
            <a href={`/events/${older.id}`} class="more-link">
              <span class="more-label">Earlier</span>
              <span class="more-title">{older.data.title}</span>
              <span class="more-date">{formatDate(older.data.date)}</span>
            </a>
          )}
          {newer && (
            <a href={`/events/${newer.id}`} class="more-link more-newer">
              <span class="more-label">Later</span>
              <span class="more-title">{newer.data.title}</span>
              <span class="more-date">{formatDate(newer.data.date)}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>

  <!-- JSON-LD structured data -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ImageGallery',
      name: event.data.title,
      description: event.data.description || `Photos from ${event.data.title}`,
      datePublished: event.data.date.toISOString(),
      location: {
        '@type': 'Place',
        name: event.data.location,
      },
      numberOfItems: photos.length,
    })}
  />
</BaseLayout>

<style>
  /* The header stays short so the first row of photographs is on screen
     when the page opens */
  .event-header {
    padding-block: clamp(0.75rem, 2.5vw, 1.75rem) clamp(1.25rem, 3vw, 2rem);
  }

  .breadcrumb {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .breadcrumb a {
    display: inline-block;
    padding-block: 0.5rem;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  h1 {
    margin-top: 0.25rem;
    font-size: clamp(2rem, 1.3rem + 3.2vw, 3.75rem);
    font-weight: 700;
    line-height: 1.03;
    letter-spacing: -0.034em;
    text-wrap: balance;
  }

  .event-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin-top: 0.6rem;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    color: var(--muted);
  }

  .event-description {
    margin-top: 0.9rem;
    max-width: 38em;
    font-size: 1.0625rem;
  }

  .event-content :global(p) {
    margin-top: 0.9rem;
    max-width: 38em;
    font-size: 1.0625rem;
  }

  /* Markdown-authored bodies (the collection glob accepts .md) */
  .event-content :global(a:hover) {
    text-decoration-thickness: 0.14em;
  }

  .no-photos {
    color: var(--muted);
    /* padding-block only: the shorthand would zero the gutter */
    padding-block: 3rem;
  }

  /* The way on to the next set, once this one has been looked through */
  .more-events {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .more-link {
    display: grid;
    gap: 0.1rem;
    text-decoration: none;
  }

  .more-newer {
    margin-left: auto;
    text-align: right;
  }

  .more-label,
  .more-date {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .more-title {
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .more-link:hover .more-title {
    text-decoration: underline;
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.16em;
  }
</style>
