---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { getImageUrl } from '../../lib/images';
import {
  getSortedEvents,
  formatLongDate,
  formatMonthYear,
  meaningfulDescription,
  photoCountLabel,
  type EventEntry,
} from '../../lib/events';

export async function getStaticPaths() {
  const events = await getSortedEvents();
  return events.map((event, i) => ({
    params: { slug: event.id },
    props: {
      event,
      // Newest first: the next one along the list is the older event
      newer: events[i - 1] as EventEntry | undefined,
      older: events[i + 1] as EventEntry | undefined,
    },
  }));
}

const { event, newer, older } = Astro.props;
const { Content } = await render(event);

const photos = event.data.photos || [];
const description = meaningfulDescription(event);
const ogImageUrl = getImageUrl(event.data.cover, {
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
---

<BaseLayout
  title={event.data.title}
  description={event.data.description ||
    `Photos from ${event.data.title} at ${event.data.location}`}
  ogImage={ogImageUrl}
  ogImageAlt={`Cover photo from ${event.data.title} at ${event.data.location}`}
>
  <article class="event-page">
    <header class="event-header frame">
      <nav class="breadcrumb label" aria-label="Breadcrumb">
        <a href="/#events">All events</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{event.data.title}</span>
      </nav>

      <h1 class="event-title display">{event.data.title}</h1>

      <div class="event-sub">
        <p class="event-meta">
          <span>{event.data.location}</span>
          <span aria-hidden="true">&middot;</span>
          <time datetime={event.data.date.toISOString().slice(0, 10)}>
            {formatLongDate(event.data.date)}
          </time>
          {
            photos.length > 0 && (
              <>
                <span aria-hidden="true">&middot;</span>
                <span>{photoCountLabel(photos.length)}</span>
              </>
            )
          }
        </p>
        {description && <p class="event-description">{description}</p>}
        <div class="event-content">
          <Content />
        </div>
        {
          photos.length > 0 && (
            <p class="event-hint label">
              Spotted yourself? Open a photo to save it full size or copy a link to it.
            </p>
          )
        }
      </div>
    </header>

    {
      photos.length > 0 ? (
        <PhotoGrid photos={photos} eventTitle={event.data.title} />
      ) : (
        <p class="no-photos frame">Photos from this event are on their way.</p>
      )
    }

    {
      (newer || older) && (
        <nav class="sequence frame" aria-label="More events">
          {older ? (
            <a href={`/events/${older.id}/`} class="sequence-link sequence-older">
              <span class="label">Older</span>
              <span class="sequence-title display">{older.data.title}</span>
              <span class="label">
                {older.data.location.split(',')[0]}, {formatMonthYear(older.data.date)}
              </span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a href={`/events/${newer.id}/`} class="sequence-link sequence-newer">
              <span class="label">Newer</span>
              <span class="sequence-title display">{newer.data.title}</span>
              <span class="label">
                {newer.data.location.split(',')[0]}, {formatMonthYear(newer.data.date)}
              </span>
            </a>
          )}
        </nav>
      )
    }
  </article>

  <!-- JSON-LD structured data -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ImageGallery',
      name: event.data.title,
      description: event.data.description || `Photos from ${event.data.title}`,
      datePublished: event.data.date.toISOString(),
      creator: { '@type': 'Person', name: 'Marcel Cutts' },
      location: {
        '@type': 'Place',
        name: event.data.location,
      },
      numberOfItems: photos.length,
    })}
  />
</BaseLayout>

<style>
  .event-header {
    padding-top: clamp(1rem, 3vw, 2.25rem);
    padding-bottom: clamp(1.25rem, 3vw, 2.25rem);
  }

  .breadcrumb {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    min-width: 0;
  }

  .breadcrumb a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .breadcrumb a:hover {
    text-decoration-color: var(--signal);
  }

  .breadcrumb [aria-current='page'] {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .event-title {
    margin-top: clamp(1.25rem, 4vw, 3rem);
    font-size: clamp(3rem, 8vw, 7.5rem);
    max-width: 14ch;
  }

  .event-sub {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    max-width: var(--measure);
  }

  /* Wide screens: details sit beside the title so the photos start sooner */
  @media (min-width: 1100px) {
    .event-header {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      column-gap: clamp(2rem, 5vw, 5rem);
    }

    .breadcrumb {
      grid-column: 1 / -1;
    }

    .event-sub {
      margin-top: 0;
      padding-bottom: 0.4rem;
    }
  }

  .event-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    font-stretch: 87.5%;
    font-weight: 560;
  }

  .event-description,
  .event-content :global(p) {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    color: var(--text-soft);
  }

  .event-content :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-underline-offset: 0.2em;
  }

  .event-hint {
    margin-top: 1rem;
  }

  .no-photos {
    padding-block: 3rem;
    color: var(--text-soft);
  }

  /* ---- Older / newer ---- */

  .sequence {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  .sequence-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
    transition: border-color 160ms ease;
  }

  .sequence-newer {
    align-items: flex-end;
    text-align: right;
  }

  .sequence-link:hover {
    border-top-color: var(--signal);
  }

  .sequence-title {
    font-size: clamp(1.5rem, 3.5vw, 3rem);
    font-weight: 740;
  }

  @media (max-width: 599px) {
    .sequence {
      grid-template-columns: minmax(0, 1fr);
    }

    .sequence > span:empty {
      display: none;
    }

    .sequence-newer {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
