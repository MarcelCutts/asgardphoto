---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { getImageUrl } from '../../lib/images';
import { rollMap } from '../../lib/rolls';

export async function getStaticPaths() {
  const events = await getCollection('events');
  const rolls = rollMap(events);
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event, rollNo: rolls.get(event.id) ?? '' },
  }));
}

const { event, rollNo } = Astro.props;
const { Content } = await render(event);

const formattedDate = event.data.date.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});

const photos = event.data.photos || [];
// OG image: use a larger size for social sharing
const ogImageUrl = getImageUrl(event.data.cover, {
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
---

<BaseLayout
  title={event.data.title}
  description={event.data.description ||
    `Photos from ${event.data.title} at ${event.data.location}`}
  ogImage={ogImageUrl}
  ogImageAlt={`Cover photo from ${event.data.title} at ${event.data.location}`}
>
  <Fragment slot="head">
    <!-- Grotesk only renders in event prose, so only event pages pay for it -->
    <link
      rel="preload"
      href="/fonts/SchibstedGrotesk-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </Fragment>

  <article class="event-page">
    <header class="event-header container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Index</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{event.data.title}</span>
      </nav>

      <div class="roll-head">
        <p class="roll-no">{rollNo}</p>

        <div class="roll-body">
          <h1>{event.data.title}</h1>

          <p class="event-meta">
            <span class="event-location">{event.data.location}</span>
            <span aria-hidden="true">&middot;</span>
            <time datetime={event.data.date.toISOString()}>{formattedDate}</time>
            {
              photos.length > 0 && (
                <>
                  <span aria-hidden="true">&middot;</span>
                  <span>
                    {photos.length} frame{photos.length === 1 ? '' : 's'}
                  </span>
                </>
              )
            }
          </p>

          {event.data.description && <p class="event-description">{event.data.description}</p>}

          <div class="event-content">
            <Content />
          </div>
        </div>
      </div>
    </header>

    {
      photos.length > 0 ? (
        <div class="contact-sheet container">
          <div class="sheet-strip">
            <span class="sheet-label">Contact sheet</span>
            <span class="sheet-roll">{rollNo}</span>
          </div>
          <PhotoGrid photos={photos} eventTitle={event.data.title} />
        </div>
      ) : (
        <p class="no-photos container">Frames pending development.</p>
      )
    }
  </article>

  <!-- JSON-LD structured data -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ImageGallery',
      name: event.data.title,
      description: event.data.description || `Photos from ${event.data.title}`,
      datePublished: event.data.date.toISOString(),
      location: {
        '@type': 'Place',
        name: event.data.location,
      },
      numberOfItems: photos.length,
    })}
  />
</BaseLayout>

<style>
  .event-header {
    padding-top: clamp(1.5rem, 4vw, 2.75rem);
  }

  .breadcrumb {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--bone-soft);
  }

  .breadcrumb a {
    transition: color 160ms ease;
  }

  .breadcrumb a:hover {
    color: var(--vermilion);
  }

  .breadcrumb [aria-current='page'] {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Roll header on the rail, mirroring the parent section anatomy */
  .roll-head {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: clamp(1rem, 3vw, 2.5rem);
  }

  .roll-no {
    grid-column: 1;
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--vermilion);
    padding-top: 0.55em;
  }

  .roll-no::after {
    content: '';
    display: block;
    width: 1.75rem;
    height: 1px;
    margin-top: 0.6rem;
    background: var(--rule-faint);
  }

  .roll-body {
    grid-column: 2;
    min-width: 0;
  }

  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.6rem, 6vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .event-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6em;
    margin-top: var(--space-sm);
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--bone-soft);
  }

  .event-description {
    margin-top: var(--space-md);
    max-width: var(--measure);
    font-size: 1.04rem;
    color: var(--bone-soft);
  }

  .event-content {
    margin-top: var(--space-sm);
  }

  .event-content :global(p) {
    max-width: var(--measure);
    font-size: 1.04rem;
    line-height: 1.65;
    color: var(--bone-soft);
  }

  .event-content :global(p + p) {
    margin-top: var(--space-sm);
  }

  /* Markdown-authored bodies (the collection glob accepts .md); the global
     `a { color: inherit }` reset would otherwise leave these unmarked */
  .event-content :global(a) {
    color: var(--vermilion);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: var(--rule);
    transition: text-decoration-color 160ms ease;
  }

  .event-content :global(a:hover) {
    text-decoration-color: var(--vermilion);
  }

  .contact-sheet {
    margin-top: clamp(1.75rem, 4vw, 3rem);
  }

  .sheet-strip {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-top: 0.7rem;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--bone);
  }

  .sheet-roll {
    font-weight: 400;
    color: var(--bone-faint);
  }

  .no-photos {
    font-family: var(--mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--bone-soft);
    /* padding-block only: the shorthand would zero .container's gutter */
    padding-block: var(--space-xl);
  }

  @media (max-width: 720px) {
    .roll-head {
      grid-template-columns: minmax(0, 1fr);
    }

    .roll-no {
      grid-column: 1;
      padding-top: 0;
      margin-bottom: 0.75rem;
    }

    .roll-body {
      grid-column: 1;
    }
  }
</style>
