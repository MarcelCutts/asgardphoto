---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventStrip from '../components/EventStrip.astro';
import { getImageUrl, getSrcSet, RESPONSIVE_WIDTHS } from '../lib/images';
import { getPhotoSize } from '../lib/dimensions';

/**
 * The photograph the site opens with. Chosen by hand: a wide frame that says
 * "conference" before any text does. If its event is ever removed, the page
 * falls back to the newest event's cover.
 */
const OPENING = {
  event: 'react-summit-2023',
  photo: 'react-summit-2023/_DSC6700.jpg',
  alt: 'The main hall at React Summit: the audience seated either side of a long central aisle that leads to the stage.',
};

const events = await getCollection('events');

// Newest first
const sortedEvents = events.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const totalPhotos = events.reduce((sum, event) => sum + (event.data.photos?.length ?? 0), 0);

// Event dates are plain calendar days, so read them in UTC throughout
const yearOf = (date: Date) => date.getUTCFullYear();
const years = [...new Set(sortedEvents.map((event) => yearOf(event.data.date)))];
const eventsByYear = years.map((year) => ({
  year,
  events: sortedEvents.filter((event) => yearOf(event.data.date) === year),
}));
const span =
  years.length > 1 ? `${years[years.length - 1]} to ${years[0]}` : String(years[0] ?? '');

const openingEvent = sortedEvents.find((event) => event.id === OPENING.event) ?? sortedEvents[0];
const opening =
  openingEvent?.id === OPENING.event
    ? OPENING
    : openingEvent && {
        event: openingEvent.id,
        photo: openingEvent.data.cover,
        alt: `Cover photo from ${openingEvent.data.title}`,
      };
const openingSize = opening && getPhotoSize(opening.photo);
const openingCaption =
  openingEvent &&
  [
    openingEvent.data.title,
    openingEvent.data.location.split(',')[0],
    openingEvent.data.date.toLocaleDateString('en-GB', {
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    }),
  ].join(', ');

const ogImageUrl =
  opening &&
  getImageUrl(opening.photo, {
    width: 1200,
    height: 630,
    fit: 'cover',
    format: 'jpeg',
  });
---

<BaseLayout
  title="Conference Photography"
  description="Photography from tech conferences and developer events."
  ogImage={ogImageUrl}
  ogImageAlt={opening?.alt}
>
  <Fragment slot="head">
    {
      opening && (
        <link
          rel="preload"
          as="image"
          href={getImageUrl(opening.photo, { width: 1600, format: 'auto' })}
          imagesrcset={getSrcSet(opening.photo, RESPONSIVE_WIDTHS.hero, { format: 'auto' })}
          imagesizes="100vw"
          fetchpriority="high"
        />
      )
    }
  </Fragment>

  {
    opening && openingSize && (
      <a href={`/events/${opening.event}`} class="opening">
        <img
          src={getImageUrl(opening.photo, { width: 1600, format: 'auto' })}
          srcset={getSrcSet(opening.photo, RESPONSIVE_WIDTHS.hero, { format: 'auto' })}
          sizes="100vw"
          width={openingSize.width}
          height={openingSize.height}
          alt={opening.alt}
          fetchpriority="high"
          decoding="async"
          class="opening-photo"
        />
        <span class="opening-caption gutter">{openingCaption}</span>
      </a>
    )
  }

  <section class="intro gutter">
    <h1>Photographs from tech conferences and meetups</h1>
    <p class="intro-count">
      {events.length} events, {totalPhotos.toLocaleString('en-GB')} photographs, {span}
    </p>
  </section>

  <div id="events">
    {
      eventsByYear.length > 0 ? (
        eventsByYear.map(({ year, events: yearEvents }) => (
          <section class="year" aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`} class="year-heading">
              {year}
            </h2>
            <div class="year-events">
              {yearEvents.map((event) => (
                <EventStrip
                  slug={event.id}
                  title={event.data.title}
                  date={event.data.date}
                  location={event.data.location}
                  cover={event.data.cover}
                  photos={event.data.photos ?? []}
                />
              ))}
            </div>
          </section>
        ))
      ) : (
        <p class="no-events gutter">No events yet.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  /* The page opens on a photograph, edge to edge, with the next thing
     already showing beneath it */
  .opening {
    display: block;
    text-decoration: none;
  }

  .opening-photo {
    width: 100%;
    height: min(68svh, 62vw);
    object-fit: cover;
    object-position: 50% 42%;
    background: var(--surface);
  }

  .opening-caption {
    display: block;
    padding-top: 0.55rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .opening:hover .opening-caption {
    color: var(--text);
    text-decoration: underline;
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 3rem;
    padding-block: clamp(2rem, 5vw, 3.75rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .intro h1 {
    max-width: 16em;
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }

  .intro-count {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    color: var(--muted);
  }

  /* Years down the left; each year's events run off the right-hand edge */
  .year {
    padding-left: var(--gutter);
  }

  .year + .year {
    margin-top: clamp(2.75rem, 6vw, 4.5rem);
  }

  .year-heading {
    font-size: clamp(2.25rem, 1.7rem + 2.2vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .year-events {
    display: grid;
    /* minmax(0, …): the strips are wider than the page by design and must
       not widen the track they sit in */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 4.5vw, 3rem);
    margin-top: 1.25rem;
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .year {
      display: grid;
      grid-template-columns: 10.5rem minmax(0, 1fr);
      align-items: start;
    }

    .year-heading {
      position: sticky;
      top: 1.25rem;
    }

    .year-events {
      margin-top: 0.35rem;
    }
  }

  .no-events {
    color: var(--muted);
    padding-block: 3rem;
  }
</style>
