---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import FadeIn from '../components/FadeIn.astro';
import { getImageUrl } from '../lib/images';

const events = await getCollection('events');

// Sort events by date, newest first
const sortedEvents = events.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Use the most recent event's cover as the OG image for the homepage
const ogImageUrl =
  sortedEvents.length > 0
    ? getImageUrl(sortedEvents[0].data.cover, {
        width: 1200,
        height: 630,
        fit: 'cover',
        format: 'jpeg',
      })
    : undefined;
---

<BaseLayout
  title="Conference Photography"
  description="Photography from tech conferences and developer events."
  ogImage={ogImageUrl}
  ogImageAlt={sortedEvents.length > 0
    ? `Cover photo from ${sortedEvents[0].data.title}`
    : undefined}
>
  <section class="hero">
    <h1 class="hero-title">Asgard Photography</h1>
    <p class="hero-subtitle">Capturing moments from tech events across the world.</p>
  </section>

  <section class="events-section" aria-labelledby="events-heading">
    <h2 id="events-heading" class="visually-hidden">Events</h2>
    {
      sortedEvents.length > 0 ? (
        <div class="events-grid">
          {sortedEvents.map((event, index) => (
            <FadeIn delay={Math.min(index, 6) * 100}>
              <EventCard
                slug={event.id}
                title={event.data.title}
                date={event.data.date}
                location={event.data.location}
                cover={event.data.cover}
                photoCount={event.data.photos?.length}
              />
            </FadeIn>
          ))}
        </div>
      ) : (
        <p class="no-events">No events yet. Check back soon!</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: var(--space-2xl) var(--space-lg) var(--space-xl);
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--font-size-3xl);
    font-weight: 700;
    letter-spacing: var(--letter-spacing-tighter);
    line-height: var(--line-height-tight);
    margin-bottom: var(--space-md);
    animation: slideUp 0.6s ease-out both;
  }

  .hero-subtitle {
    font-size: var(--font-size-lg);
    font-weight: 400;
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto;
    animation: slideUp 0.6s ease-out 0.1s both;
  }

  @keyframes slideUp {
    from {
      transform: translateY(16px);
    }
    to {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-subtitle {
      animation: none;
    }
  }

  .events-section {
    padding: 0 var(--space-lg) var(--space-xl);
    max-width: 1400px;
    margin: 0 auto;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-lg);
  }

  @media (max-width: 640px) {
    .events-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }

  .no-events {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-xl);
  }
</style>
