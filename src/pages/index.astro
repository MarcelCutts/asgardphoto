---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { getImageUrl } from '../lib/images';
import { rollMap } from '../lib/rolls';

const events = await getCollection('events');
const rolls = rollMap(events);

// Sort events by date, newest first (roll numbers read descending)
const sortedEvents = events.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const totalFrames = events.reduce((sum, event) => sum + (event.data.photos?.length ?? 0), 0);
const rollCount = String(events.length).padStart(3, '0');

// Use the most recent event's cover as the OG image for the homepage
const ogImageUrl =
  sortedEvents.length > 0
    ? getImageUrl(sortedEvents[0].data.cover, {
        width: 1200,
        height: 630,
        fit: 'cover',
        format: 'jpeg',
      })
    : undefined;
---

<BaseLayout
  title="Conference Photography"
  description="Photography from tech conferences and developer events."
  ogImage={ogImageUrl}
  ogImageAlt={sortedEvents.length > 0
    ? `Cover photo from ${sortedEvents[0].data.title}`
    : undefined}
>
  <Fragment slot="head">
    <!-- The hero tagline is serif italic, above the fold -->
    <link
      rel="preload"
      href="/fonts/InstrumentSerif-Italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </Fragment>

  <section class="hero container">
    <h1 class="wordmark">Asgard<span class="wordmark-ext">.photo</span></h1>
    <p class="tagline">The photographic record of the tech conference circuit.</p>
    <div class="hero-meta apparatus">
      <span>Rolls {rollCount} &middot; Frames {totalFrames}</span>
      <svg class="rune" viewBox="0 0 24 32" aria-hidden="true">
        <path d="M7 2v28M7 5l13 8M7 14l13 8"></path>
      </svg>
    </div>
  </section>

  <section class="events-section container" aria-labelledby="events-heading">
    <div class="events-strip apparatus">
      <h2 id="events-heading" class="apparatus">Index of rolls</h2>
      <span class="events-order">Newest first</span>
    </div>
    {
      sortedEvents.length > 0 ? (
        <div class="events-grid">
          {sortedEvents.map((event) => (
            <EventCard
              slug={event.id}
              rollNo={rolls.get(event.id) ?? ''}
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              cover={event.data.cover}
              photoCount={event.data.photos?.length}
            />
          ))}
        </div>
      ) : (
        <p class="no-events">No rolls filed yet.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(2.5rem, 6vw, 4.25rem);
    padding-bottom: clamp(1.75rem, 4vw, 3rem);
  }

  .wordmark {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(3.2rem, 10.5vw, 8.5rem);
    line-height: 0.95;
    letter-spacing: -0.015em;
    margin-left: -0.04em;
  }

  .wordmark-ext {
    color: var(--vermilion);
  }

  .tagline {
    margin-top: clamp(1rem, 2.5vw, 1.75rem);
    max-width: 30ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    line-height: 1.25;
    text-wrap: balance;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: clamp(1.75rem, 4vw, 3rem);
    padding-top: 0.7rem;
    border-top: 1px solid var(--rule);
    color: var(--bone-soft);
  }

  .hero-meta .rune {
    color: var(--vermilion);
  }

  /* `rise` comes from BaseLayout's global styles */
  @media (prefers-reduced-motion: no-preference) {
    .wordmark {
      animation: rise 700ms var(--ease-brand) 220ms both;
    }

    .tagline {
      animation: rise 700ms var(--ease-brand) 340ms both;
    }

    .hero-meta {
      animation: rise 700ms var(--ease-brand) 460ms both;
    }
  }

  .events-section {
    padding-bottom: var(--space-xl);
  }

  .events-strip {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-top: 0.7rem;
    border-top: 1px solid var(--rule);
    margin-bottom: var(--space-lg);
  }

  .events-strip h2 {
    font-weight: 500;
    color: var(--bone);
  }

  .events-order {
    color: var(--bone-faint);
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-lg);
  }

  @media (max-width: 640px) {
    .events-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }

  .no-events {
    font-family: var(--mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--bone-soft);
    padding: var(--space-xl) 0;
  }
</style>
