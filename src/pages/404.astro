---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="There is nothing at this address.">
  <section class="notfound gutter">
    <h1>Page not found</h1>
    <p>
      There is nothing at this address. <a href="/">See all events</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(3rem, 10vw, 7rem);
  }

  h1 {
    font-size: clamp(2rem, 1.3rem + 3.2vw, 3.75rem);
    font-weight: 700;
    line-height: 1.03;
    letter-spacing: -0.034em;
  }

  p {
    margin-top: 1rem;
    max-width: 34em;
    font-size: 1.125rem;
    color: var(--muted);
  }

  a {
    color: var(--text);
  }

  a:hover {
    text-decoration-thickness: 0.14em;
  }
</style>
