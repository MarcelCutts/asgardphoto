---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page isn't on asgard.photo.">
  <section class="notfound frame">
    <span class="tally" aria-hidden="true"></span>
    <h1 class="display">Nothing on this stage.</h1>
    <p class="notfound-lede">
      The page you were after isn&rsquo;t here. It may have moved, or the link may be mistyped.
    </p>
    <a class="notfound-back" href="/#events">Browse all events</a>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(3rem, 12vw, 8rem);
  }

  .tally {
    display: block;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--signal);
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: clamp(3rem, 9vw, 7.5rem);
    max-width: 12ch;
  }

  .notfound-lede {
    margin-top: 1.25rem;
    max-width: var(--measure);
    font-size: 1.125rem;
    color: var(--text-soft);
  }

  .notfound-back {
    display: inline-block;
    margin-top: 2rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
</style>
