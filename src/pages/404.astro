---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Frame not found" description="This page is not in the archive.">
  <Fragment slot="head">
    <!-- The lede is serif italic, above the fold -->
    <link
      rel="preload"
      href="/fonts/InstrumentSerif-Italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </Fragment>

  <section class="notfound container">
    <p class="notfound-code">R—404</p>
    <h1>Frame not found.</h1>
    <p class="notfound-lede">This frame was never filed, or has been struck from the record.</p>
    <a class="notfound-back" href="/">Return to the index</a>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(3rem, 10vw, 6rem);
  }

  .notfound-code {
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--vermilion);
  }

  .notfound-code::after {
    content: '';
    display: block;
    width: 1.75rem;
    height: 1px;
    margin-top: 0.6rem;
    background: var(--rule-faint);
  }

  h1 {
    margin-top: var(--space-md);
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.6rem, 6vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .notfound-lede {
    margin-top: var(--space-sm);
    max-width: var(--measure);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--bone-soft);
  }

  .notfound-back {
    display: inline-block;
    margin-top: var(--space-lg);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--bone);
    border-bottom: 1.5px solid var(--vermilion);
    padding-bottom: 0.2em;
    transition: color 160ms ease;
  }

  .notfound-back:hover {
    color: var(--vermilion);
  }
</style>
