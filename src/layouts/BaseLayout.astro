---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description = 'Conference photography by Asgard Photo',
  ogImage,
  ogImageAlt,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#16130d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://photos.asgard.photo" />
    <link rel="dns-prefetch" href="https://photos.asgard.photo" />

    <!-- Self-hosted type (latin subsets, OFL licences). Base preloads are
         the faces every page paints above the fold: serif for titles, mono
         400/500 for the masthead and roll apparatus. Page-specific faces
         (grotesk prose, serif italic) come through the head slot. -->
    <link
      rel="preload"
      href="/fonts/InstrumentSerif-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/IBMPlexMono-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/IBMPlexMono-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />

    <ClientRouter />

    <title>{title} | Asgard Photo</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Asgard Photo" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={`${title} | Asgard Photo`} />
    <meta property="og:description" content={description} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
        </>
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={`${title} | Asgard Photo`} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="masthead" transition:persist="masthead">
      <div class="container">
        <div class="scotch"></div>
        <nav aria-label="Main navigation" class="masthead-meta apparatus">
          <a href="/" class="masthead-home"><strong>Asgard Photo</strong></a>
          <span class="masthead-mid">Conference photography</span>
          <a href="https://asgard.tech" class="masthead-ext">Asgard.tech</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="colophon">
      <div class="container colophon-row apparatus">
        <span>Asgard Enterprises Limited &middot; Est. MMXVII</span>
        <svg class="rune" viewBox="0 0 24 32" aria-hidden="true">
          <path d="M7 2v28M7 5l13 8M7 14l13 8"></path>
        </svg>
        <span class="colophon-note">Developed &amp; fixed in London</span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /*
   * The Archive: the dark annexe of the asgard.tech Dossier.
   * Ink ground, bone type, proofreader's vermilion — the broadsheet
   * after dark. Apparatus stays quiet; photographs are the ink.
   */

  @font-face {
    font-family: 'Instrument Serif';
    src: url('/fonts/InstrumentSerif-Regular.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Instrument Serif';
    src: url('/fonts/InstrumentSerif-Italic.woff2') format('woff2');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: 'Schibsted Grotesk';
    src: url('/fonts/SchibstedGrotesk-Variable.woff2') format('woff2');
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'IBM Plex Mono';
    src: url('/fonts/IBMPlexMono-Regular.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'IBM Plex Mono';
    src: url('/fonts/IBMPlexMono-Medium.woff2') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  :root {
    /* Ink & bone */
    --ink: #16130d;
    --ink-high: #1d1912;
    --bone: #f0ead9;
    --bone-soft: rgba(240, 234, 217, 0.62);
    --bone-faint: rgba(240, 234, 217, 0.55); /* contrast floor for small text */
    --vermilion: #ff5a24;
    --vermilion-deep: #e0490f; /* large text / non-text UI only */
    --rule-strong: #f0ead9;
    --rule: rgba(240, 234, 217, 0.28);
    --rule-faint: rgba(240, 234, 217, 0.16);
    --grid-line: rgba(240, 234, 217, 0.035);

    /* Type */
    --serif: 'Instrument Serif', 'Iowan Old Style', Georgia, serif;
    --grotesk: 'Schibsted Grotesk', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --mono: 'IBM Plex Mono', 'Courier New', monospace;

    /* 8px spacing scale */
    --space-xs: 0.5rem;
    --space-sm: 1rem;
    --space-md: 1.5rem;
    --space-lg: 2rem;
    --space-xl: 3rem;
    --space-2xl: 4rem;

    /* Layout */
    --page-max: 1140px;
    --rail: 5.5rem;
    --measure: 66ch;

    /* Motion */
    --ease-brand: cubic-bezier(0.22, 1, 0.36, 1);

    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 16px;
    color: var(--bone);
    background-color: var(--ink);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    font-family: var(--grotesk);
    font-weight: 400;
    line-height: 1.65;
    background-color: var(--ink);
    background-image:
      radial-gradient(120% 90% at 75% -10%, rgba(240, 234, 217, 0.04), rgba(240, 234, 217, 0) 60%),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 31px,
        var(--grid-line) 31px,
        var(--grid-line) 32px
      );
  }

  main {
    flex: 1;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  ::selection {
    background: var(--vermilion);
    color: var(--ink);
  }

  :focus-visible {
    outline: 2px solid var(--vermilion);
    outline-offset: 3px;
  }

  .container {
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  /* Apparatus: archival mono labels */
  .apparatus {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  /* Apparatus: the shared brand rune (Ansuz) */
  .rune {
    display: inline-block;
    width: 0.9em;
    height: 1.15em;
    vertical-align: -0.18em;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: square;
    fill: none;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-sm);
    z-index: 10;
    padding: var(--space-xs) var(--space-sm);
    background: var(--vermilion);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .skip-link:focus {
    top: var(--space-sm);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .scotch {
      transform-origin: left;
      animation: draw 700ms var(--ease-brand) both;
    }

    .masthead-meta {
      animation: rise 600ms var(--ease-brand) 150ms both;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-delay: 0s !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<style>
  .masthead {
    padding-top: clamp(1rem, 3vw, 2rem);
  }

  /* Broadsheet scotch rule: one thick stroke over one thin */
  .scotch {
    border-top: 3px solid var(--rule-strong);
  }

  .scotch::after {
    content: '';
    display: block;
    height: 1px;
    margin-top: 2px;
    background: var(--rule-strong);
  }

  .masthead-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--rule);
    color: var(--bone-soft);
  }

  .masthead-home strong {
    font-weight: 500;
    color: var(--bone);
    transition: color 160ms ease;
  }

  .masthead-home:hover strong {
    color: var(--vermilion);
  }

  .masthead-ext {
    transition: color 160ms ease;
  }

  .masthead-ext:hover {
    color: var(--vermilion);
  }

  .colophon {
    border-top: 1px solid var(--rule);
    padding-block: var(--space-md);
    margin-top: var(--space-2xl);
  }

  .colophon-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    color: var(--bone-soft);
  }

  .colophon .rune {
    color: var(--vermilion);
  }

  @media (max-width: 640px) {
    .masthead-mid,
    .colophon-note {
      display: none;
    }
  }
</style>
