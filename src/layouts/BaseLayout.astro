---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description = 'Conference photography by Asgard Photo',
  ogImage,
  ogImageAlt,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#161616" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://photos.asgard.photo" />
    <link rel="dns-prefetch" href="https://photos.asgard.photo" />

    <!-- One self-hosted typeface (latin subset, OFL), used on every page -->
    <link
      rel="preload"
      href="/fonts/SchibstedGrotesk-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />

    <ClientRouter />

    <title>{title} | Asgard Photo</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Asgard Photo" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={`${title} | Asgard Photo`} />
    <meta property="og:description" content={description} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
        </>
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={`${title} | Asgard Photo`} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="masthead" transition:persist="masthead">
      <nav aria-label="Main navigation" class="masthead-nav gutter">
        <a href="/" class="brand">
          <svg class="rune" viewBox="0 0 24 32" aria-hidden="true">
            <path d="M7 2v28M7 5l13 8M7 14l13 8"></path>
          </svg>
          Asgard Photo
        </a>
        <span class="masthead-links">
          <a href="#contact">Contact</a>
          <a href="https://asgard.tech">asgard.tech</a>
        </span>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer gutter" id="contact">
      <div class="footer-columns">
        <section>
          <h2>Booking</h2>
          <p>
            To have a conference or meetup photographed, email
            <a href="mailto:marcel@asgard.tech">marcel@asgard.tech</a>.
          </p>
        </section>
        <section>
          <h2>In a photo?</h2>
          <p>
            If you would like a photo of yourself taken down, open it, copy the address and email it
            to
            <a href="mailto:marcel@asgard.tech">marcel@asgard.tech</a>.
          </p>
        </section>
      </div>
      <p class="footer-legal">
        Asgard Enterprises Limited. Technology consulting at
        <a href="https://asgard.tech">asgard.tech</a>.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  /*
   * asgard.photo
   *
   * The photographs supply the colour, so everything around them is neutral:
   * an untinted dark grey ground, one typeface, plain labels.
   */

  @font-face {
    font-family: 'Schibsted Grotesk';
    src: url('/fonts/SchibstedGrotesk-Variable.woff2') format('woff2');
    font-weight: 400 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --bg: #161616;
    --surface: #232323; /* behind a photograph that has not loaded yet */
    --text: #ededed;
    --muted: #a8a8a8;
    --rule: #333333;
    --accent: #a9b6ff; /* focus rings and selection only */

    --font: 'Schibsted Grotesk', 'Helvetica Neue', Helvetica, Arial, sans-serif;

    --gutter: clamp(1rem, 2.4vw, 1.75rem);
    --photo-gap: 0.375rem;

    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    color: var(--text);
    background-color: var(--bg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    font-family: var(--font);
    font-size: 1rem;
    line-height: 1.5;
    background-color: var(--bg);
  }

  main {
    flex: 1;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a {
    color: inherit;
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.18em;
  }

  ::selection {
    background: var(--accent);
    color: var(--bg);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .gutter {
    padding-inline: var(--gutter);
  }

  /* The shared Asgard mark: Ansuz, the a-rune */
  .rune {
    width: 0.85rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: square;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--gutter);
    z-index: 10;
    padding: 0.5rem 0.9rem;
    background: var(--text);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
  }

  .skip-link:focus {
    top: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-delay: 0s !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<style>
  .masthead-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding-block: 0.6rem;
    font-size: 1.1875rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .masthead-links {
    display: flex;
    align-items: center;
    gap: clamp(1.1rem, 3vw, 2rem);
  }

  .masthead-links a {
    padding-block: 0.6rem;
    text-decoration: none;
  }

  .brand:hover,
  .masthead-links a:hover {
    text-decoration: underline;
  }

  .site-footer {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-block: clamp(2rem, 5vw, 3rem) 2.5rem;
    border-top: 1px solid var(--rule);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 1.75rem clamp(2rem, 6vw, 5rem);
    max-width: 62rem;
  }

  .site-footer h2 {
    font-size: 1rem;
    font-weight: 700;
  }

  .site-footer p {
    max-width: 34em;
    color: var(--muted);
  }

  .site-footer section p {
    margin-top: 0.3rem;
  }

  .site-footer a {
    color: var(--text);
  }

  .site-footer a:hover {
    text-decoration-thickness: 0.14em;
  }

  .footer-legal {
    margin-top: clamp(2rem, 5vw, 3rem);
    font-size: 0.9375rem;
  }
</style>
