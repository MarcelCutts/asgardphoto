---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description = 'Conference photography by Asgard Photo',
  ogImage,
  ogImageAlt,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d0d0e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://photos.asgard.photo" />
    <link rel="dns-prefetch" href="https://photos.asgard.photo" />

    <!-- One self-hosted variable face (Mona Sans, OFL, latin subset) with
         weight and width axes; shared with asgard.tech. -->
    <link
      rel="preload"
      href="/fonts/MonaSans-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />

    <ClientRouter />

    <title>{title} | Asgard Photo</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Asgard Photo" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={`${title} | Asgard Photo`} />
    <meta property="og:description" content={description} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
        </>
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={`${title} | Asgard Photo`} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="masthead" transition:persist="masthead">
      <nav aria-label="Main navigation" class="masthead-row frame">
        <a href="/" class="masthead-home" aria-current={isHome ? 'page' : undefined}>
          <svg class="rune" viewBox="0 0 24 32" aria-hidden="true">
            <path d="M7 2v28M7 5l13 8M7 14l13 8"></path>
          </svg>
          <span>Asgard Photo</span>
        </a>
        <ul class="masthead-links" role="list">
          <li><a href="/#events">Events</a></li>
          <li><a href="/#hire">Hire</a></li>
          <li><a href="https://asgard.tech">Asgard.tech</a></li>
        </ul>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="colophon frame">
      <div class="colophon-use">
        <h2 class="colophon-title">Found yourself?</h2>
        <p>
          You&rsquo;re welcome to use photos of you: your profile, your blog, your talk slides,
          wherever. A credit to Asgard Photo is appreciated. If you&rsquo;d like a photo taken down,
          or want to ask about anything else, email
          <a href="mailto:marcel@asgard.tech">marcel@asgard.tech</a>.
        </p>
      </div>
      <div class="colophon-row">
        <p>
          Photographs by Marcel Cutts. Asgard Photo is part of
          <a href="https://asgard.tech">Asgard</a>.
        </p>
        <p class="colophon-small">&copy; Asgard Enterprises Limited, London</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /*
   * House lights down.
   * The page is the auditorium after the lights drop: a neutral near-black
   * that doesn't tint the photographs, and type that steps back. The one
   * colour is signal red, used the way a camera tally or on-air light is:
   * small, rare, and only to mean "this one".
   */

  @font-face {
    font-family: 'Mona Sans';
    src: url('/fonts/MonaSans-Variable.woff2') format('woff2-variations');
    font-weight: 200 900;
    font-stretch: 75% 125%;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --ground: #0d0d0e;
    --ground-raised: #19191b;
    --text: #edece8;
    --text-soft: #a9a8a4; /* 8.2:1 on ground */
    --line: rgba(237, 236, 232, 0.14);
    --line-strong: rgba(237, 236, 232, 0.32);
    --signal: #e0301e; /* shared with asgard.tech; non-text and large text */
    --signal-text: #ff5a47; /* small text on the dark ground, 5.9:1 */

    --font: 'Mona Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;

    --gutter: clamp(1rem, 3.2vw, 2.75rem);
    --measure: 62ch;
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);

    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    color: var(--text);
    background-color: var(--ground);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    -webkit-text-size-adjust: 100%;
  }

  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    font-family: var(--font);
    font-size: 1rem;
    font-weight: 420;
    line-height: 1.55;
    font-variant-numeric: tabular-nums;
    background-color: var(--ground);
  }

  main {
    flex: 1;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  ul[role='list'] {
    list-style: none;
  }

  ::selection {
    background: var(--signal);
    color: #fff;
  }

  :focus-visible {
    outline: 2px solid var(--signal-text);
    outline-offset: 3px;
  }

  /* Full-width frame with a fluid gutter: the photo pages run edge to edge */
  .frame {
    width: 100%;
    padding-inline: var(--gutter);
  }

  /* Display type: Mona Sans pulled narrow and heavy, like a lineup bill */
  .display {
    font-stretch: 75%;
    font-weight: 780;
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* Small labels: semi-condensed, never all-caps */
  .label {
    font-size: 0.875rem;
    font-stretch: 87.5%;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--text-soft);
  }

  .rune {
    display: inline-block;
    width: 0.8em;
    height: 1.05em;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: square;
    fill: none;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--gutter);
    z-index: 10;
    padding: 0.5rem 1rem;
    background: var(--text);
    color: var(--ground);
    font-weight: 600;
  }

  .skip-link:focus {
    top: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-delay: 0s !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<style>
  .masthead {
    position: relative;
    z-index: 2;
  }

  .masthead-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
    font-stretch: 87.5%;
    font-weight: 560;
  }

  .masthead-home {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.0625rem;
    font-weight: 680;
    letter-spacing: -0.005em;
  }

  .masthead-home .rune {
    color: var(--signal);
  }

  .masthead-links {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
    color: var(--text-soft);
  }

  .masthead-links a {
    display: inline-block;
    padding-block: 0.5rem;
    transition: color 150ms ease;
  }

  .masthead-links a:hover {
    color: var(--text);
  }

  .colophon {
    display: grid;
    gap: 2rem;
    margin-top: clamp(4rem, 10vw, 8rem);
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
    color: var(--text-soft);
  }

  .colophon-use {
    max-width: var(--measure);
  }

  .colophon-title {
    margin-bottom: 0.4rem;
    font-size: 1.125rem;
    font-stretch: 87.5%;
    font-weight: 680;
    color: var(--text);
  }

  .colophon-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  .colophon a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .colophon a:hover {
    text-decoration-color: var(--signal);
  }
</style>
