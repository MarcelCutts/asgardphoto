---
import { getImageUrl, getSrcSet, RESPONSIVE_WIDTHS } from '../lib/images';

interface Props {
  slug: string;
  rollNo: string;
  title: string;
  date: Date;
  location: string;
  cover: string;
  photoCount?: number;
}

const { slug, rollNo, title, date, location, cover, photoCount } = Astro.props;

const formattedDate = date.toLocaleDateString('en-GB', {
  month: 'short',
  year: 'numeric',
});
---

<article class="event-card">
  <a href={`/events/${slug}`} class="event-link" aria-label={`View ${title} photos`}>
    <div class="print">
      <img
        src={getImageUrl(cover, { width: 800, format: 'auto' })}
        srcset={getSrcSet(cover, RESPONSIVE_WIDTHS.cover, { format: 'auto' })}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, (max-width: 1140px) 45vw, 340px"
        alt={`Cover photo from ${title}`}
        loading="lazy"
        decoding="async"
        class="cover-image"
        width="800"
        height="500"
      />
    </div>
    <div class="caption">
      <p class="caption-index apparatus">
        <span class="caption-roll">{rollNo}</span>
        {
          photoCount != null && (
            <span class="caption-count">
              {photoCount} frame{photoCount === 1 ? '' : 's'}
            </span>
          )
        }
      </p>
      <h2 class="caption-title">{title}</h2>
      <p class="caption-meta apparatus">
        <span class="caption-location">{location}</span>
        <span class="caption-date">{formattedDate}</span>
      </p>
    </div>
  </a>
</article>

<style>
  /* Hover language is vermilion rules + label shifts only — the
     photograph itself never moves, scales, or gains overlays. */

  .event-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .event-link:focus-visible {
    outline: none;
  }

  .event-card:has(.event-link:focus-visible) {
    outline: 2px solid var(--vermilion);
    outline-offset: 3px;
  }

  /* Mounted contact print: hairline frame with a narrow mat */
  .print {
    border: 1px solid var(--rule-faint);
    padding: 6px;
    transition: border-color 200ms ease;
  }

  .event-card:hover .print,
  .event-card:has(.event-link:focus-visible) .print {
    border-color: var(--vermilion);
  }

  .cover-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--ink-high);
  }

  .caption {
    padding-top: 0.7rem;
  }

  .caption-index {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
    font-weight: 500;
    color: var(--bone-faint);
  }

  .caption-roll {
    transition: color 200ms ease;
  }

  .event-card:hover .caption-roll,
  .event-card:has(.event-link:focus-visible) .caption-roll {
    color: var(--vermilion);
  }

  .caption-count::before {
    content: '· ';
  }

  .caption-title {
    margin-top: 0.35rem;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.005em;
    color: var(--bone);
  }

  .caption-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: 0.45rem;
    color: var(--bone-soft);
  }

  .caption-location {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .caption-date {
    flex-shrink: 0;
  }
</style>
