---
import { getImageUrl, getSrcSet, RESPONSIVE_WIDTHS } from '../lib/images';
import { getPhotoSize } from '../lib/dimensions';

interface Props {
  photos: string[];
  eventTitle: string;
}

const { photos, eventTitle } = Astro.props;

// Row heights in px at 16px/rem: keep in step with --row in the styles below
const ROW = { narrow: 116, medium: 192, wide: 280 };
// A photo grows to fill its row; on average it ends up about a fifth wider
// than its share at the nominal row height
const GROWTH = 1.2;

const grid = photos.map((photo) => {
  const { width, height, ratio } = getPhotoSize(photo);
  const slot = (row: number) => `min(100vw, ${Math.round(ratio * row * GROWTH)}px)`;
  return {
    photo,
    width,
    height,
    ratio,
    sizes: `(max-width: 40rem) ${slot(ROW.narrow)}, (max-width: 64rem) ${slot(ROW.medium)}, ${slot(ROW.wide)}`,
  };
});

// Pre-generate responsive image data for the lightbox
const lightboxImages = photos.map((photo) => ({
  src: getImageUrl(photo, { width: 1600, quality: 90, format: 'auto' }),
  srcset: getSrcSet(photo, RESPONSIVE_WIDTHS.lightbox, { quality: 90, format: 'auto' }),
}));
---

<!--
  Justified rows, in the order the photographs were taken. Each item's share
  of its row is proportional to its aspect ratio, so every photo in a row ends
  up the same height and none is cropped. Pure CSS: it needs the ratios up
  front (src/data/photo-dimensions.json) and no script.
-->
<div class="photo-grid" role="list" aria-label={`Photos from ${eventTitle}`}>
  {
    grid.map(({ photo, width, height, ratio, sizes }, index) => (
      <figure class="photo-item" role="listitem" style={`--ratio: ${ratio}`}>
        <button
          type="button"
          class="photo-button"
          data-index={index}
          aria-label={`View photo ${index + 1} of ${photos.length}`}
        >
          <img
            src={getImageUrl(photo, { width: 800, format: 'auto' })}
            srcset={getSrcSet(photo, RESPONSIVE_WIDTHS.grid, { format: 'auto' })}
            sizes={sizes}
            width={width}
            height={height}
            alt={`Photo ${index + 1} from ${eventTitle}`}
            loading={index < 8 ? 'eager' : 'lazy'}
            decoding="async"
            class="photo-image"
          />
        </button>
      </figure>
    ))
  }
</div>

<!-- Lightbox container with photos data for client-side script -->
<dialog
  id="lightbox"
  class="lightbox"
  aria-label="Photo viewer"
  data-photos={JSON.stringify(lightboxImages)}
>
  <div class="lightbox-content">
    <button type="button" class="lightbox-close" aria-label="Close photo viewer">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="square"
      >
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>
    <button type="button" class="lightbox-prev" aria-label="Previous photo">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="square"
      >
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
    </button>
    <div class="lightbox-image-container">
      <div class="lightbox-spinner" aria-hidden="true" data-testid="loading-spinner">
        <svg viewBox="0 0 24 24" width="48" height="48">
          <circle
            cx="12"
            cy="12"
            r="10"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-dasharray="31.4 31.4"></circle>
        </svg>
      </div>
      <img id="lightbox-image" alt="Photo viewer" class="lightbox-image" />
    </div>
    <button type="button" class="lightbox-next" aria-label="Next photo">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="square"
      >
        <path d="M9 18l6-6-6-6"></path>
      </svg>
    </button>
    <div class="lightbox-counter" aria-live="polite" data-testid="lightbox-counter"></div>
  </div>
</dialog>

<script>
  // Lightbox initialization - runs on astro:page-load for View Transitions support
  function initLightbox() {
    const lightboxEl = document.getElementById('lightbox') as HTMLDialogElement | null;
    if (!lightboxEl) return; // Not on a page with lightbox

    // Read photos data from data attribute (set at build time)
    const photosData = lightboxEl.dataset.photos;
    if (!photosData) return;

    // Non-nullable reference for use in closures
    const lightbox = lightboxEl;

    const photos: Array<{ src: string; srcset: string }> = JSON.parse(photosData);

    const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
    const lightboxContent = document.querySelector('.lightbox-content') as HTMLElement;
    const lightboxSpinner = document.querySelector('.lightbox-spinner') as HTMLElement;
    const lightboxCounter = document.querySelector('.lightbox-counter') as HTMLElement;
    const closeBtn = document.querySelector('.lightbox-close') as HTMLButtonElement;
    const prevBtn = document.querySelector('.lightbox-prev') as HTMLButtonElement;
    const nextBtn = document.querySelector('.lightbox-next') as HTMLButtonElement;
    const photoButtons = document.querySelectorAll('.photo-button');

    let currentIndex = 0;
    let previouslyFocused: Element | null = null;
    let touchStartX = 0;
    let touchStartY = 0;

    // Preload cache for background preloading
    const preloadedImages = new Set<string>();

    function preloadImage(src: string) {
      if (preloadedImages.has(src)) return;
      preloadedImages.add(src);
      const img = new Image();
      img.src = src;
    }

    function preloadAdjacent(index: number) {
      const nextIdx = (index + 1) % photos.length;
      const prevIdx = (index - 1 + photos.length) % photos.length;
      preloadImage(photos[nextIdx].src);
      preloadImage(photos[prevIdx].src);
    }

    function showLoading() {
      lightboxSpinner.classList.add('visible');
      lightboxImage.classList.add('loading');
    }

    function hideLoading() {
      lightboxSpinner.classList.remove('visible');
      lightboxImage.classList.remove('loading');
    }

    // Every photo has an address (#photo-12), so one can be shared or cited.
    // replaceState keeps the browser history to one entry per page and
    // carries the router's own state object through untouched.
    const PHOTO_HASH = /^#photo-(\d+)$/;

    function indexFromAddress(): number | null {
      const match = location.hash.match(PHOTO_HASH);
      if (!match) return null;
      const index = parseInt(match[1], 10) - 1;
      return index >= 0 && index < photos.length ? index : null;
    }

    function setAddress(index: number | null) {
      const address = index === null ? location.pathname + location.search : `#photo-${index + 1}`;
      history.replaceState(history.state, '', address);
    }

    function updateLightbox(index: number) {
      currentIndex = index;
      lightboxCounter.textContent = `${index + 1} / ${photos.length}`;
      setAddress(index);

      const { src, srcset } = photos[index];

      // Show loading state
      showLoading();
      lightboxImage.removeAttribute('src');
      lightboxImage.removeAttribute('srcset');

      // Set up load handler
      const onLoad = () => {
        hideLoading();
        lightboxImage.removeEventListener('load', onLoad);
        lightboxImage.removeEventListener('error', onLoad);
      };
      lightboxImage.addEventListener('load', onLoad);
      lightboxImage.addEventListener('error', onLoad);

      // Set the new image source with responsive srcset
      lightboxImage.srcset = srcset;
      lightboxImage.sizes = '100vw';
      lightboxImage.src = src;
      lightboxImage.alt = `Photo ${index + 1} of ${photos.length}`;

      // Preload adjacent images
      preloadAdjacent(index);
    }

    function openLightbox(index: number, returnFocusTo: Element | null = document.activeElement) {
      previouslyFocused = returnFocusTo;
      updateLightbox(index);
      lightbox.showModal();
      closeBtn.focus();
    }

    function closeLightbox() {
      lightbox.close();
    }

    function showPrev() {
      const newIndex = currentIndex > 0 ? currentIndex - 1 : photos.length - 1;
      updateLightbox(newIndex);
    }

    function showNext() {
      const newIndex = currentIndex < photos.length - 1 ? currentIndex + 1 : 0;
      updateLightbox(newIndex);
    }

    // Event listeners for photo buttons
    photoButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = parseInt((btn as HTMLElement).dataset.index || '0', 10);
        openLightbox(index);
      });
    });

    closeBtn.addEventListener('click', closeLightbox);
    prevBtn.addEventListener('click', showPrev);
    nextBtn.addEventListener('click', showNext);

    // Teardown lives on the close event so every dismissal runs it — the
    // close button, Escape (native cancel), and Android's back gesture /
    // CloseWatcher, which never touch the keydown handler.
    lightbox.addEventListener('close', () => {
      setAddress(null);
      lightboxImage.removeAttribute('src');
      lightboxImage.removeAttribute('srcset');
      hideLoading();
      if (previouslyFocused && previouslyFocused instanceof HTMLElement) {
        previouslyFocused.focus();
      }
    });

    lightbox.addEventListener('click', (e) => {
      // The content div covers the whole zero-padding dialog, so its dark
      // margin is the backdrop; the image, buttons and counter are children.
      if (e.target === lightbox || e.target === lightboxContent) closeLightbox();
    });

    // Touch swipe support for mobile
    lightbox.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      },
      { passive: true }
    );

    lightbox.addEventListener(
      'touchend',
      (e) => {
        const diffX = touchStartX - e.changedTouches[0].clientX;
        const diffY = touchStartY - e.changedTouches[0].clientY;
        if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50) {
          if (diffX > 0) {
            showNext();
          } else {
            showPrev();
          }
        }
      },
      { passive: true }
    );

    // Keyboard navigation
    // Escape is absent on purpose: showModal()'s native cancel handles it
    lightbox.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') showPrev();
      else if (e.key === 'ArrowRight') showNext();
      else if (e.key === 'Tab') {
        const focusable = [closeBtn, prevBtn, nextBtn];
        const idx = focusable.indexOf(document.activeElement as HTMLButtonElement);
        if (idx === -1) {
          e.preventDefault();
          closeBtn.focus();
        } else if (e.shiftKey && idx === 0) {
          e.preventDefault();
          nextBtn.focus();
        } else if (!e.shiftKey && idx === 2) {
          e.preventDefault();
          closeBtn.focus();
        }
      }
    });

    // Arriving on a photo's address opens it. Closing hands focus to that
    // photo in the grid, which also scrolls it into view.
    const linked = indexFromAddress();
    if (linked !== null) {
      openLightbox(linked, document.querySelector(`.photo-button[data-index="${linked}"]`));
    }
  }

  // Initialize on page load (works with View Transitions / ClientRouter)
  document.addEventListener('astro:page-load', initLightbox);
</script>

<style>
  .photo-grid {
    --row: 7.25rem;

    display: flex;
    flex-wrap: wrap;
    gap: var(--photo-gap);
  }

  /* Soaks up the spare width in the last row so its photos keep their size */
  .photo-grid::after {
    content: '';
    flex-grow: 1000000;
  }

  .photo-item {
    flex: calc(var(--ratio) * 100) 1 calc(var(--ratio) * var(--row));
    aspect-ratio: var(--ratio);
    min-width: 0;
    background: var(--surface);
  }

  @media (min-width: 40.0625rem) {
    .photo-grid {
      --row: 12rem;
    }
  }

  @media (min-width: 64.0625rem) {
    .photo-grid {
      --row: 17.5rem;
    }
  }

  .photo-button {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: transparent;
    cursor: zoom-in;
  }

  /* Outlines sit inside the frame so they are never clipped by a neighbour */
  .photo-button:hover {
    outline: 2px solid var(--text);
    outline-offset: -2px;
  }

  .photo-button:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }

  .photo-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    padding: 0;
    border: none;
    background: rgba(12, 12, 12, 0.97);
    color: var(--text);
    overscroll-behavior: contain;
  }

  /* Hold the page still while the lightbox is modal; the dialog has no
     scrollable overflow, so wheel/touch would chain to the document and
     the user would land at a different scroll position on close. */
  :global(body:has(dialog[open])) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox {
      animation: lightboxFadeIn 0.2s ease-out;
    }
  }

  @keyframes lightboxFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox-content {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  /* On a phone the photograph gets the full width; the controls sit in a
     bar beneath it. On wider screens the arrows move to the sides. */
  .lightbox-image-container {
    --bar: 4.5rem;

    position: relative;
    max-width: 100vw;
    max-height: calc(100dvh - 2 * var(--bar));
    min-width: 100px;
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-spinner {
    position: absolute;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.15s ease-out;
    pointer-events: none;
  }

  .lightbox-spinner.visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox-spinner svg {
      animation: spin 1s linear infinite;
    }
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .lightbox-image {
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    object-fit: contain;
    transition: opacity 0.15s ease-out;
  }

  .lightbox-image.loading {
    opacity: 0;
  }

  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(12, 12, 12, 0.6);
    color: var(--text);
    cursor: pointer;
    transition: background-color 160ms ease;
  }

  .lightbox-close svg,
  .lightbox-prev svg,
  .lightbox-next svg {
    display: block;
  }

  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(237, 237, 237, 0.18);
  }

  .lightbox-close:focus-visible,
  .lightbox-prev:focus-visible,
  .lightbox-next:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .lightbox-close {
    top: 0.75rem;
    right: 0.75rem;
  }

  .lightbox-prev {
    left: 0.75rem;
    bottom: 0.75rem;
  }

  .lightbox-next {
    right: 0.75rem;
    bottom: 0.75rem;
  }

  .lightbox-counter {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    min-height: 3rem;
    display: grid;
    place-items: center;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }

  @media (min-width: 48.0625rem) {
    .lightbox-image-container {
      max-width: calc(100vw - 10rem);
      max-height: calc(100dvh - 6rem);
    }

    .lightbox-image {
      max-height: calc(100dvh - 6rem);
    }

    .lightbox-prev,
    .lightbox-next {
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
    }

    .lightbox-prev {
      left: 1rem;
    }

    .lightbox-next {
      right: 1rem;
    }

    .lightbox-close {
      top: 1rem;
      right: 1rem;
    }

    .lightbox-counter {
      bottom: 0.5rem;
    }
  }
</style>
