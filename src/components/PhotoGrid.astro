---
import { getImageUrl, getSrcSet, RESPONSIVE_WIDTHS } from '../lib/images';
import { Masonry } from 'astro-masonry';

interface Props {
  photos: string[];
  eventTitle: string;
}

const { photos, eventTitle } = Astro.props;

// Pre-generate responsive image data for the lightbox
const lightboxImages = photos.map((photo) => ({
  src: getImageUrl(photo, { width: 1600, quality: 90, format: 'auto' }),
  srcset: getSrcSet(photo, RESPONSIVE_WIDTHS.lightbox, { quality: 90, format: 'auto' }),
  // Largest rendition, as JPEG so it saves and shares anywhere
  full: getImageUrl(photo, { width: 4000, quality: 92, format: 'jpeg', fit: 'scale-down' }),
}));
---

<div class="photo-grid-wrapper frame" role="list" aria-label={`Photos from ${eventTitle}`}>
  <Masonry
    breakpointCols={{
      default: 4,
      1100: 3,
      700: 2,
    }}
    class="photo-grid"
    columnClass="photo-column"
  >
    {
      photos.map((photo, index) => (
        <figure class="photo-item" role="listitem" id={`photo-${index + 1}`}>
          <button
            type="button"
            class="photo-button"
            data-index={index}
            aria-label={`View photo ${index + 1} of ${photos.length}`}
          >
            <img
              src={getImageUrl(photo, { width: 800, format: 'auto' })}
              srcset={getSrcSet(photo, RESPONSIVE_WIDTHS.grid, { format: 'auto' })}
              sizes="(max-width: 700px) 50vw, (max-width: 1100px) 33vw, 25vw"
              alt={`Photo ${index + 1} from ${eventTitle}`}
              loading={index < 8 ? 'eager' : 'lazy'}
              decoding="async"
              class="photo-image"
            />
          </button>
        </figure>
      ))
    }
  </Masonry>
</div>

<!-- Lightbox container with photos data for client-side script -->
<dialog
  id="lightbox"
  class="lightbox"
  aria-label="Photo viewer"
  data-photos={JSON.stringify(lightboxImages)}
>
  <div class="lightbox-content">
    <button type="button" class="lightbox-close" aria-label="Close photo viewer">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>
    <button type="button" class="lightbox-prev" aria-label="Previous photo">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
    </button>
    <div class="lightbox-image-container">
      <div class="lightbox-spinner" aria-hidden="true" data-testid="loading-spinner">
        <svg viewBox="0 0 24 24" width="40" height="40">
          <circle
            cx="12"
            cy="12"
            r="10"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-dasharray="31.4 31.4"></circle>
        </svg>
      </div>
      <img id="lightbox-image" alt="Photo viewer" class="lightbox-image" />
    </div>
    <button type="button" class="lightbox-next" aria-label="Next photo">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <path d="M9 18l6-6-6-6"></path>
      </svg>
    </button>
    <div class="lightbox-bar">
      <div class="lightbox-counter" aria-live="polite" data-testid="lightbox-counter"></div>
      <div class="lightbox-actions">
        <button type="button" class="lightbox-action lightbox-copy">Copy link</button>
        <a class="lightbox-action lightbox-full" href="#" target="_blank" rel="noopener"
          >Full size<span class="visually-hidden"> (opens in a new tab)</span></a
        >
      </div>
      <p class="lightbox-status visually-hidden" role="status"></p>
    </div>
  </div>
</dialog>

<script>
  // Lightbox initialization - runs on astro:page-load for View Transitions support
  function initLightbox() {
    const lightboxEl = document.getElementById('lightbox') as HTMLDialogElement | null;
    if (!lightboxEl) return; // Not on a page with lightbox

    // Read photos data from data attribute (set at build time)
    const photosData = lightboxEl.dataset.photos;
    if (!photosData) return;

    // Non-nullable reference for use in closures
    const lightbox = lightboxEl;

    const photos: Array<{ src: string; srcset: string; full: string }> = JSON.parse(photosData);

    const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
    const lightboxContent = document.querySelector('.lightbox-content') as HTMLElement;
    const lightboxSpinner = document.querySelector('.lightbox-spinner') as HTMLElement;
    const lightboxCounter = document.querySelector('.lightbox-counter') as HTMLElement;
    const closeBtn = document.querySelector('.lightbox-close') as HTMLButtonElement;
    const prevBtn = document.querySelector('.lightbox-prev') as HTMLButtonElement;
    const nextBtn = document.querySelector('.lightbox-next') as HTMLButtonElement;
    const copyBtn = document.querySelector('.lightbox-copy') as HTMLButtonElement;
    const fullLink = document.querySelector('.lightbox-full') as HTMLAnchorElement;
    const statusEl = document.querySelector('.lightbox-status') as HTMLElement;
    const photoButtons = document.querySelectorAll('.photo-button');

    let currentIndex = 0;
    let previouslyFocused: Element | null = null;
    let touchStartX = 0;
    let touchStartY = 0;

    // Preload cache for background preloading
    const preloadedImages = new Set<string>();

    function preloadImage(src: string) {
      if (preloadedImages.has(src)) return;
      preloadedImages.add(src);
      const img = new Image();
      img.src = src;
    }

    function preloadAdjacent(index: number) {
      const nextIdx = (index + 1) % photos.length;
      const prevIdx = (index - 1 + photos.length) % photos.length;
      preloadImage(photos[nextIdx].src);
      preloadImage(photos[prevIdx].src);
    }

    function showLoading() {
      lightboxSpinner.classList.add('visible');
      lightboxImage.classList.add('loading');
    }

    function hideLoading() {
      lightboxSpinner.classList.remove('visible');
      lightboxImage.classList.remove('loading');
    }

    function updateLightbox(index: number) {
      currentIndex = index;
      lightboxCounter.textContent = `${index + 1} / ${photos.length}`;
      statusEl.textContent = '';

      const { src, srcset, full } = photos[index];
      fullLink.href = full;

      // Every photo has its own address, so the one you're looking at is
      // the one you share. replaceState keeps the ClientRouter's state.
      history.replaceState(history.state, '', `#photo-${index + 1}`);

      // Show loading state
      showLoading();
      lightboxImage.removeAttribute('src');
      lightboxImage.removeAttribute('srcset');

      // Set up load handler
      const onLoad = () => {
        hideLoading();
        lightboxImage.removeEventListener('load', onLoad);
        lightboxImage.removeEventListener('error', onLoad);
      };
      lightboxImage.addEventListener('load', onLoad);
      lightboxImage.addEventListener('error', onLoad);

      // Set the new image source with responsive srcset
      lightboxImage.srcset = srcset;
      lightboxImage.sizes = '100vw';
      lightboxImage.src = src;
      lightboxImage.alt = `Photo ${index + 1} of ${photos.length}`;

      // Preload adjacent images
      preloadAdjacent(index);
    }

    function openLightbox(index: number, trigger: Element | null = document.activeElement) {
      previouslyFocused = trigger;
      updateLightbox(index);
      lightbox.showModal();
      closeBtn.focus();
    }

    function closeLightbox() {
      lightbox.close();
    }

    function showPrev() {
      const newIndex = currentIndex > 0 ? currentIndex - 1 : photos.length - 1;
      updateLightbox(newIndex);
    }

    function showNext() {
      const newIndex = currentIndex < photos.length - 1 ? currentIndex + 1 : 0;
      updateLightbox(newIndex);
    }

    // Event listeners for photo buttons
    photoButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = parseInt((btn as HTMLElement).dataset.index || '0', 10);
        openLightbox(index);
      });
    });

    closeBtn.addEventListener('click', closeLightbox);
    prevBtn.addEventListener('click', showPrev);
    nextBtn.addEventListener('click', showNext);

    // Teardown lives on the close event so every dismissal runs it — the
    // close button, Escape (native cancel), and Android's back gesture /
    // CloseWatcher, which never touch the keydown handler.
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        statusEl.textContent = 'Link copied';
        copyBtn.textContent = 'Link copied';
      } catch {
        statusEl.textContent = 'Could not copy. The link is in the address bar.';
        copyBtn.textContent = 'Copy from address bar';
      }
      window.setTimeout(() => {
        copyBtn.textContent = 'Copy link';
      }, 2000);
    });

    lightbox.addEventListener('close', () => {
      history.replaceState(history.state, '', window.location.pathname + window.location.search);
      lightboxImage.removeAttribute('src');
      lightboxImage.removeAttribute('srcset');
      hideLoading();
      if (previouslyFocused && previouslyFocused instanceof HTMLElement) {
        previouslyFocused.focus();
      }
    });

    lightbox.addEventListener('click', (e) => {
      // The content div covers the whole zero-padding dialog, so its dark
      // margin is the backdrop; the image, buttons and counter are children.
      if (e.target === lightbox || e.target === lightboxContent) closeLightbox();
    });

    // Touch swipe support for mobile
    lightbox.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      },
      { passive: true }
    );

    lightbox.addEventListener(
      'touchend',
      (e) => {
        const diffX = touchStartX - e.changedTouches[0].clientX;
        const diffY = touchStartY - e.changedTouches[0].clientY;
        if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50) {
          if (diffX > 0) {
            showNext();
          } else {
            showPrev();
          }
        }
      },
      { passive: true }
    );

    // Keyboard navigation
    // Escape is absent on purpose: showModal()'s native cancel handles it
    lightbox.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') showPrev();
      else if (e.key === 'ArrowRight') showNext();
      else if (e.key === 'Tab') {
        const focusable: HTMLElement[] = [closeBtn, prevBtn, nextBtn, copyBtn, fullLink];
        const idx = focusable.indexOf(document.activeElement as HTMLElement);
        const last = focusable.length - 1;
        if (idx === -1) {
          e.preventDefault();
          closeBtn.focus();
        } else if (e.shiftKey && idx === 0) {
          e.preventDefault();
          focusable[last].focus();
        } else if (!e.shiftKey && idx === last) {
          e.preventDefault();
          closeBtn.focus();
        }
      }
    });

    // Deep link: /events/<slug>/#photo-12 opens straight onto that photo
    const match = /^#photo-(\d+)$/.exec(window.location.hash);
    if (match) {
      const index = parseInt(match[1], 10) - 1;
      if (index >= 0 && index < photos.length) {
        openLightbox(index, document.querySelector(`.photo-button[data-index="${index}"]`));
      }
    }
  }

  // Initialize on page load (works with View Transitions / ClientRouter)
  document.addEventListener('astro:page-load', initLightbox);
</script>

<style>
  .photo-grid-wrapper {
    /* Masonry columns carry half the gap each side; pull the outer halves back */
    --gap: 6px;
    padding-inline: calc(var(--gutter) - var(--gap) / 2);
  }

  :global(.photo-column) {
    padding: 0 calc(var(--gap) / 2);
  }

  .photo-item {
    margin: 0 0 var(--gap) 0;
    scroll-margin-top: 1rem;
  }

  @media (max-width: 700px) {
    .photo-grid-wrapper {
      --gap: 4px;
    }
  }

  .photo-button {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: transparent;
    cursor: zoom-in;
  }

  /* Hover: a hairline frame and the tally dot, the photo itself stays put */
  .photo-button::after {
    content: '';
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    opacity: 0;
    transition: opacity 140ms ease;
  }

  .photo-button:hover::after,
  .photo-button:focus-visible::after {
    opacity: 1;
  }

  .photo-button:focus-visible {
    outline: 2px solid var(--signal-text);
    outline-offset: 2px;
  }

  .photo-image {
    width: 100%;
    height: auto;
    display: block;
    background: var(--ground-raised);
  }

  /* ---- Lightbox ---- */

  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    padding: 0;
    border: none;
    background: #050505;
    color: var(--text);
    overscroll-behavior: contain;
  }

  /* Hold the page still while the lightbox is modal; the dialog has no
     scrollable overflow, so wheel/touch would chain to the document and
     the user would land at a different scroll position on close. */
  :global(body:has(dialog[open])) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] {
      animation: lightbox-in 180ms ease-out;
    }
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox-content {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding-bottom: 3.5rem;
  }

  .lightbox-image-container {
    position: relative;
    max-width: calc(100vw - 8rem);
    max-height: calc(100dvh - 6rem);
    min-width: 100px;
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-spinner {
    position: absolute;
    color: var(--text-soft);
    opacity: 0;
    transition: opacity 0.15s ease-out;
    pointer-events: none;
  }

  .lightbox-spinner.visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox-spinner svg {
      animation: spin 1s linear infinite;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .lightbox-image {
    max-width: 100%;
    max-height: calc(100dvh - 6rem);
    object-fit: contain;
    transition: opacity 0.15s ease-out;
  }

  .lightbox-image.loading {
    opacity: 0;
  }

  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: transparent;
    border: none;
    color: var(--text);
    cursor: pointer;
    border-radius: 50%;
    transition: background-color 140ms ease;
  }

  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(237, 236, 232, 0.12);
  }

  .lightbox-close {
    top: 0.75rem;
    right: 0.75rem;
  }

  .lightbox-prev {
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 0.5rem clamp(1rem, 3vw, 1.5rem);
    font-stretch: 87.5%;
  }

  .lightbox-counter {
    font-weight: 560;
    color: var(--text-soft);
  }

  .lightbox-actions {
    display: flex;
    gap: 0.5rem;
  }

  .lightbox-action {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-weight: 560;
    cursor: pointer;
    transition:
      border-color 140ms ease,
      background-color 140ms ease;
  }

  .lightbox-action:hover {
    border-color: var(--text);
  }

  .lightbox-full {
    background: var(--text);
    border-color: var(--text);
    color: var(--ground);
  }

  .lightbox-full:hover {
    background: #fff;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .lightbox-image-container {
      max-width: 100vw;
    }

    .lightbox-prev,
    .lightbox-next {
      top: auto;
      bottom: 4rem;
      transform: none;
      background: rgba(5, 5, 5, 0.6);
    }
  }
</style>
